<Window x:Class="HelpDesk.Views.TicketCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HelpDesk.Views"
        mc:Ignorable="d"
        Title="HelpDesk – Новая заявка"
        Height="480"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Новая заявка"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="2"
                   Text="Категория"
                   FontSize="14"/>

        <ComboBox x:Name="CategoryComboBox"
                  Grid.Row="3"
                  Height="32"
                  FontSize="14"
                  SelectedIndex="0">
            <ComboBoxItem Content="Выберите категорию" IsEnabled="False"/>
            <ComboBoxItem Content="Оборудование"/>
            <ComboBoxItem Content="Программное обеспечение"/>
            <ComboBoxItem Content="Сеть"/>
            <ComboBoxItem Content="Учётная запись"/>
            <ComboBoxItem Content="Периферия"/>
            <ComboBoxItem Content="Другое"/>
        </ComboBox>

        <TextBlock Grid.Row="5"
                   Text="Описание проблемы"
                   FontSize="14"/>

        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="6"
                 Height="80"
                 FontSize="14"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"/>

        <TextBlock Grid.Row="8"
                   Text="Приоритет"
                   FontSize="14"/>

        <ComboBox x:Name="PriorityComboBox"
                  Grid.Row="9"
                  Height="32"
                  FontSize="14"
                  SelectedIndex="1">
            <ComboBoxItem Content="Низкий"/>
            <ComboBoxItem Content="Средний"/>
            <ComboBoxItem Content="Высокий"/>
        </ComboBox>

        <StackPanel Grid.Row="11"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="110"
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="110"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>